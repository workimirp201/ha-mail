##############################################################################
# HA-MAIL :: MASTER VARIABLE TEMPLATE
# ---------------------------------------------------------------------------
# Copy to `.env`, fill in, then run `./deploy.sh` on EACH node.
#
#   cp env.example .env && chmod 600 .env && $EDITOR .env
#
# This single file is the ONLY thing you change to deploy a new domain onto a
# new pair of servers. Nothing in templates/ or scripts/ is domain-specific.
#
# RULE: every value below is consumed by bin/render.sh through a *whitelisted*
# envsubst. If you add a variable here you MUST also add its name to
# lib/common.sh :: RENDER_VARS, otherwise it will not be substituted.
##############################################################################

# ===========================================================================
# 1. IDENTITY OF THIS NODE
# ===========================================================================
# The ONLY line that differs between the two servers. Set to A or B.
#   A = Singapore  (ACME leader, admin-portal write leader, auto_increment_offset 1)
#   B = United States (ACME follower, admin-portal standby,  auto_increment_offset 2)
NODE_ROLE=A

# ===========================================================================
# 2. PRIMARY MAIL DOMAIN
# ===========================================================================
# The first domain hosted on the cluster. Additional domains are added later
# through the admin portal UI - they do NOT require re-running the deploy.
DOMAIN=example.com

# Service names. These are CNAME/A records that resolve to BOTH node IPs.
MAIL_HOST=mail.${DOMAIN}
WEBMAIL_HOST=webmail.${DOMAIN}
# The admin portal is deliberately single-homed on the write leader.
# See docs/AUDIT.md section 5 for why an active-active admin UI is a lie.
ADMIN_HOST=admin.${DOMAIN}
AUTOCONFIG_HOST=autoconfig.${DOMAIN}

# Postmaster / ACME registration address. Must be deliverable BEFORE deploy
# (use a third-party address for the very first bootstrap).
ADMIN_EMAIL=postmaster@${DOMAIN}

# ===========================================================================
# 3. NODE A - SINGAPORE
# ===========================================================================
NODE_A_IP=203.0.113.10
NODE_A_HOSTNAME=sg1.${DOMAIN}
NODE_A_SHORTNAME=sg1
NODE_A_REGION=ap-south
NODE_A_DKIM_SELECTOR=sg
# Address of Node A inside the private WireGuard tunnel.
NODE_A_WG_IP=10.77.0.1
# Optional: IPv6 address of Node A. Leave EMPTY to disable IPv6 entirely.
NODE_A_IP6=

# ===========================================================================
# 4. NODE B - UNITED STATES
# ===========================================================================
NODE_B_IP=198.51.100.20
NODE_B_HOSTNAME=us1.${DOMAIN}
NODE_B_SHORTNAME=us1
NODE_B_REGION=us-east
NODE_B_DKIM_SELECTOR=us
NODE_B_WG_IP=10.77.0.2
NODE_B_IP6=

# ===========================================================================
# 5. WIREGUARD INTER-NODE TUNNEL
# ===========================================================================
WG_INTERFACE=wg0
WG_PORT=51820
WG_SUBNET=10.77.0.0/24
# Keepalive is mandatory: Linode does not NAT, but stateful firewalls and the
# ~180ms RTT make silent tunnel death expensive to detect. 25s is the standard.
WG_KEEPALIVE=25
# Generated by scripts/20-wireguard.sh on first run and written to
# /etc/wireguard/keys/. You paste the PEER public key here on each node.
WG_PEER_PUBKEY=

# ===========================================================================
# 6. DATABASE
# ===========================================================================
DB_NAME=mailserver
DB_USER=mailuser
DB_PASS=CHANGE_ME_db_password
# Least-privilege account used by Postfix/Dovecot for SELECT-only map lookups.
DB_RO_USER=mailreader
DB_RO_PASS=CHANGE_ME_readonly_password
# Replication account. Only ever reachable across the WireGuard tunnel.
DB_REPL_USER=replicator
DB_REPL_PASS=CHANGE_ME_replication_password
# MariaDB root password (set non-interactively by scripts/40-mariadb.sh).
DB_ROOT_PASS=CHANGE_ME_root_password
# Roundcube keeps its own DB. Contacts/identities replicate; caches do not.
RC_DB_NAME=roundcube
RC_DB_USER=roundcube
RC_DB_PASS=CHANGE_ME_roundcube_password

# server_id must be globally unique per node. Derived from NODE_ROLE.
NODE_A_SERVER_ID=1
NODE_B_SERVER_ID=2

# ===========================================================================
# 7. ADMIN PORTAL (PostfixAdmin)
# ===========================================================================
POSTFIXADMIN_VERSION=3.3.13
POSTFIXADMIN_ROOT=/opt/postfixadmin
# Superadmin login created non-interactively by scripts/85-postfixadmin.sh.
ADMIN_USER=admin@${DOMAIN}
ADMIN_PASS=CHANGE_ME_admin_password
# PostfixAdmin's setup.php gate. Generated as a hash by the installer, but a
# plaintext seed is required to derive it deterministically on both nodes.
SETUP_PASS=CHANGE_ME_setup_password
# Default per-mailbox quota handed out by the UI, in MiB. 0 = unlimited.
DEFAULT_QUOTA_MB=2048
# Hard ceiling an admin may assign, in MiB.
MAX_QUOTA_MB=51200
# Maximum aliases / mailboxes per domain by default. -1 = unlimited.
DEFAULT_DOMAIN_ALIASES=100
DEFAULT_DOMAIN_MAILBOXES=100

# ===========================================================================
# 8. WEBMAIL (Roundcube)
# ===========================================================================
ROUNDCUBE_VERSION=1.6.9
ROUNDCUBE_ROOT=/opt/roundcube
# 24-char random string. MUST be identical on both nodes or sessions and
# stored passwords break on failover.
ROUNDCUBE_DES_KEY=CHANGE_ME_24_char_des_key_x

# ===========================================================================
# 9. MAIL STORAGE
# ===========================================================================
VMAIL_USER=vmail
VMAIL_GROUP=vmail
VMAIL_UID=5000
VMAIL_GID=5000
# Maildir++ under /var/vmail/<domain>/<localpart>/Maildir
VMAIL_ROOT=/var/vmail
# Dovecot index/control files live off the mail volume so that a restore of
# the mail volume never restores stale indexes. See docs/AUDIT.md section 4.
VMAIL_INDEX_ROOT=/var/vmail-index

# ===========================================================================
# 10. DOVECOT REPLICATION
# ===========================================================================
# doveadm TCP port. Bound to the WireGuard interface only.
DOVEADM_PORT=12345
DOVEADM_PASS=CHANGE_ME_doveadm_shared_secret
# Number of concurrent dsync connections. Keep low on high-latency links -
# each one holds a TCP session across the ocean.
REPL_MAX_CONNS=6
# Seconds to wait for a single mailbox sync before giving up and requeueing.
# Default 10s is far too aggressive for a 180ms RTT link.
REPL_SYNC_TIMEOUT=120
# How often every mailbox gets a full (not incremental) state comparison.
REPL_FULL_SYNC_INTERVAL=4h

# ===========================================================================
# 11. TLS / ACME
# ===========================================================================
# Node A issues the shared-name certificate; Node B pulls it. Never both.
# See docs/AUDIT.md section 2 (circular sync loops).
CERT_ROOT=/etc/letsencrypt
CERT_LIVE=${CERT_ROOT}/live/${MAIL_HOST}
ACME_WEBROOT=/var/www/letsencrypt
# Set to 1 for the Let's Encrypt staging CA while you are testing.
ACME_STAGING=0
# Diffie-Hellman parameter size for Postfix/Dovecot.
DH_BITS=2048

# ===========================================================================
# 12. DKIM
# ===========================================================================
# 'distinct' = each node signs with its own selector and its own private key
#              (recommended: no private key ever crosses the network).
# 'shared'   = one key copied to both nodes under a single selector.
DKIM_MODE=distinct
DKIM_KEY_BITS=2048
DKIM_PATH=/var/lib/rspamd/dkim

# ===========================================================================
# 13. SPAM / MILTER
# ===========================================================================
RSPAMD_PASS=CHANGE_ME_rspamd_controller_password
RSPAMD_WEB_PORT=11334
# Redis is node-local. Bayes tokens diverging between nodes is acceptable and
# intentional - see docs/AUDIT.md section 6.
REDIS_BIND=127.0.0.1

# ===========================================================================
# 14. FAILOVER / DNS AUTOMATION (optional)
# ===========================================================================
# Leave LINODE_API_TOKEN empty to run pure static dual-A / dual-MX failover.
# If set, bin/dns-failover.sh will withdraw a dead node's A records.
LINODE_API_TOKEN=
LINODE_DOMAIN_ID=
# TTL applied to failover-sensitive records. 300s is the practical floor.
DNS_TTL=300

# ===========================================================================
# 15. OPERATIONS
# ===========================================================================
TIMEZONE=UTC
# Where cluster health/state files live.
STATE_DIR=/var/lib/ha-mail
LOG_DIR=/var/log/ha-mail
# SSH port used for the inter-node cert sync (over the WireGuard tunnel).
SSH_PORT=22
# Alert destination for cluster monitors. Should NOT be on this cluster.
ALERT_EMAIL=alerts@example.org
